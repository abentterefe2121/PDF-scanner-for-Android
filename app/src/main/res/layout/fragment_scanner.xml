<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <com.pdfscanner.app.ui.scanner.EdgeOverlayView
        android:id="@+id/edge_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_shutter_flash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/top_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_flash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_dark"
            android:contentDescription="@string/flash"
            android:padding="8dp"
            android:src="@drawable/ic_flash"
            app:tint="@android:color/white" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/button_grid_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/grid_off"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/button_auto_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/auto_capture_on"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/button_batch_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/batch_off"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_dark"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="@string/align_document"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_controls" />

    <LinearLayout
        android:id="@+id/bottom_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/scrim_dark"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_doc"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/mode_doc"
                android:textColor="@color/edge_ready"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/mode_id_card"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/mode_id_card"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_gallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_pill_dark"
                android:contentDescription="@string/import_gallery"
                android:padding="12dp"
                android:src="@drawable/ic_gallery"
                app:tint="@android:color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/button_capture"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_shutter"
                android:contentDescription="@string/capture" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_done_batch"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:text="@string/done_pages"
                android:textColor="@color/on_primary"
                android:visibility="invisible"
                app:backgroundTint="@color/primary"
                app:cornerRadius="22dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
