<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pdfscanner.app.ui.home.HomeFragment"
        android:label="@string/home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_scanner"
            app:destination="@id/scannerFragment" />
        <action
            android:id="@+id/action_home_to_viewer"
            app:destination="@id/viewerFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/scannerFragment"
        android:name="com.pdfscanner.app.ui.scanner.ScannerFragment"
        android:label="@string/scan"
        tools:layout="@layout/fragment_scanner">
        <action
            android:id="@+id/action_scanner_to_editor"
            app:destination="@id/editorFragment" />
    </fragment>

    <fragment
        android:id="@+id/editorFragment"
        android:name="com.pdfscanner.app.ui.editor.EditorFragment"
        android:label="@string/create_pdf"
        tools:layout="@layout/fragment_editor">
        <action
            android:id="@+id/action_editor_to_scanner"
            app:destination="@id/scannerFragment"
            app:popUpTo="@id/scannerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_editor_to_crop"
            app:destination="@id/cropFragment" />
        <action
            android:id="@+id/action_editor_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/cropFragment"
        android:name="com.pdfscanner.app.ui.editor.CropFragment"
        android:label="@string/crop"
        tools:layout="@layout/fragment_crop" />

    <fragment
        android:id="@+id/viewerFragment"
        android:name="com.pdfscanner.app.ui.viewer.ViewerFragment"
        android:label="@string/viewer"
        tools:layout="@layout/fragment_viewer" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.pdfscanner.app.ui.settings.SettingsFragment"
        android:label="@string/settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
